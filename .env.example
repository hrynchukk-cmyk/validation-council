# Copy to .env and fill in your values.
# Get your key at https://openrouter.ai/keys

OPENROUTER_API_KEY=sk-or-v1-...

# Check current model IDs at https://openrouter.ai/models — IDs do go stale!
# Defaults below are examples; replace with live IDs as needed.
COUNCIL_MODELS=openai/gpt-4.1,anthropic/claude-sonnet-4-5,google/gemini-2.5-pro-preview,x-ai/grok-3

# Chairman model — used for the final verdict
CHAIRMAN_MODEL=anthropic/claude-opus-4-5

# Seconds to wait for any single model call
REQUEST_TIMEOUT=90
